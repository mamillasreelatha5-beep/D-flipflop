module d_flip_flop (
    input  wire clk,
    input  wire reset,
    input  wire d,
    output reg  q
);

    // Positive-edge triggered D Flip-Flop
    // Asynchronous active-high reset

    always @(posedge clk or posedge reset) begin
        if (reset)
            q <= 1'b0;
        else
            q <= d;
    end

endmodule