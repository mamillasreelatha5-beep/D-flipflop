`timescale 1ns/1ps

module tb_d_flip_flop;

    reg clk;
    reg reset;
    reg d;
    wire q;

    // Instantiate the D Flip-Flop
    d_flip_flop uut (
        .clk(clk),
        .reset(reset),
        .d(d),
        .q(q)
    );

    // Clock generation
    always #5 clk = ~clk;

    // Test sequence
    initial begin

        // Initialize signals
        clk   = 1'b0;
        reset = 1'b1;
        d     = 1'b0;

        // Apply reset
        #10;
        reset = 1'b0;

        // D = 0
        d = 1'b0;
        #10;

        // D = 1
        d = 1'b1;
        #10;

        // D = 0
        d = 1'b0;
        #10;

        // D = 1
        d = 1'b1;
        #10;

        // Finish simulation
        $finish;

    end

    // Display simulation values
    initial begin
        $monitor(
            "Time = %0t | Reset = %b | CLK = %b | D = %b | Q = %b",
            $time, reset, clk, d, q
        );
    end

    // Generate waveform file
    initial begin
        $dumpfile("d_flip_flop.vcd");
        $dumpvars(0, tb_d_flip_flop);
    end

endmodule